# ─────────────────────────────────────────────────────────────
# CareerVector backend environment
# Copy this file to backend/.env and fill in your real values.
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000

# MongoDB (optional — the server falls back to a local JSON store
# in backend/data/ when MONGO_URI is unset or unreachable).
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/careervector

# Google Gemini (used by /quiz/* to generate questions, /upload for resume
# skill extraction, and /match for job matching). Leave unset to fall back
# to the built-in regex/ML matching.
GEMINI_API_KEY=

# JWT auth. Set a long random string; otherwise an ephemeral secret is
# generated on each start and existing tokens are invalidated.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (optional — enables POST /auth/google).
GOOGLE_CLIENT_ID=

# Python ML service base URL (used by /match, /analyze, /roles, /quiz, /workflow).
ML_SERVICE_URL=http://localhost:5001

# Remotive job API (used by /jobs).
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
REMOTIVE_CACHE_TTL_MS=600000
REMOTIVE_RATE_LIMIT_MS=2000
